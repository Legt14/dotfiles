[arcmenu]
menu-layout='GnomeOverview'
pop-folders-data={'Library Home': 'Library Home', 'accessories': 'Accessories', 'games': 'Games', 'office': 'Office', 'system-tools': 'System Tools'}
prefs-visible-page=0
search-entry-border-radius=(true, 25)
update-notifier-project-version=65

[blur-my-shell]
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_000000000000'>, 'params': <{'radius': <30>, 'brightness': <0.59999999999999998>, 'unscaled_radius': <30>}>}>]>}}
settings-version=2

[blur-my-shell/appfolder]
brightness=0.59999999999999998
sigma=30
style-dialogs=3

[blur-my-shell/applications]
blur=false
blur-on-overview=true
dynamic-opacity=false
enable-all=false
opacity=110
sigma=13

[blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'

[blur-my-shell/dash-to-dock]
blur=true
brightness=0.59999999999999998
override-background=true
pipeline='pipeline_default'
sigma=0
static-blur=false
style-dash-to-dock=0
unblur-in-overview=true

[blur-my-shell/hidetopbar]
compatibility=true

[blur-my-shell/lockscreen]
pipeline='pipeline_default'

[blur-my-shell/overview]
pipeline='pipeline_default'
style-components=2

[blur-my-shell/panel]
blur=true
brightness=1.0
force-light-text=true
override-background=true
override-background-dynamically=true
pipeline='pipeline_default'
sigma=0
static-blur=false
style-panel=0
unblur-in-overview=true

[blur-my-shell/screenshot]
pipeline='pipeline_default'

[blur-my-shell/window-list]
brightness=0.59999999999999998
sigma=30

[dash-to-dock]
apply-custom-theme=true
background-opacity=0.0
custom-background-color=false
custom-theme-shrink=false
dash-max-icon-size=41
disable-overview-on-startup=true
dock-position='BOTTOM'
extend-height=false
height-fraction=1.0
preferred-monitor=-2
preferred-monitor-by-connector='eDP-1'
preview-size-scale=0.47999999999999998
running-indicator-style='DOT'

[dash2dock-lite]
animation-bounce=0.0
animation-fps=0
animation-magnify=0.059999999999999998
animation-rise=1.0
animation-spread=0.20000000000000001
apps-icon-front=true
autohide-dash=true
autohide-speed=0.25
background-color=(0.0, 0.0, 0.0, 0.0)
blur-background=false
blur-resolution=3
border-radius=4.083333333333333
border-thickness=0
clock-icon=false
customize-label=false
customize-topbar=false
disable-blur-at-overview=false
dock-padding=0.41125541125541126
edge-distance=0.57471264367816088
favorites-only=false
icon-effect=0
icon-resolution=0
icon-shadow=false
icon-size=0.0
icon-spacing=0.55128205128205132
items-pullout-angle=0.16
label-border-radius=0.34210526315789469
mounted-icon=false
msg-to-ext=''
open-app-animation=false
panel-mode=false
preferred-monitor=0
pressure-sense=false
pressure-sense-sensitivity=0.059999999999999998
scroll-sensitivity=0.059999999999999998
separator-thickness=1
shrink-icons=true
topbar-background-color=(0.0, 0.0, 0.0, 0.0)
topbar-border-thickness=0
trash-icon=true

[forge]
css-last-update=uint32 37
focus-on-hover-enabled=true
move-pointer-focus-enabled=true
window-gap-hidden-on-single=false
workspace-skip-tile='0'

[forge/keybindings]
con-split-horizontal=['<Super>z']
con-split-layout-toggle=['<Super>g']
con-split-vertical=['<Super>v']
con-stacked-layout-toggle=['<Shift><Super>s']
con-tabbed-layout-toggle=['<Shift><Super>t']
con-tabbed-showtab-decoration-toggle=['<Control><Alt>y']
focus-border-toggle=['<Super>x']
mod-mask-mouse-tile='Super'
prefs-tiling-toggle=['<Super>w']
window-focus-down=['<Super>j']
window-focus-left=['<Super>h']
window-focus-right=['<Super>l']
window-focus-up=['<Super>k']
window-gap-size-decrease=['<Control><Super>minus']
window-gap-size-increase=['<Control><Super>plus']
window-move-down=['<Shift><Super>j']
window-move-left=['<Shift><Super>h']
window-move-right=['<Shift><Super>l']
window-move-up=['<Shift><Super>k']
window-resize-bottom-decrease=['<Shift><Control><Super>i']
window-resize-bottom-increase=['<Control><Super>u']
window-resize-left-decrease=['<Shift><Control><Super>o']
window-resize-left-increase=['<Control><Super>y']
window-resize-right-decrease=['<Shift><Control><Super>y']
window-resize-right-increase=['<Control><Super>o']
window-resize-top-decrease=['<Shift><Control><Super>u']
window-resize-top-increase=['<Control><Super>i']
window-snap-center=['<Control><Alt>c']
window-snap-one-third-left=['<Control><Alt>d']
window-snap-one-third-right=['<Control><Alt>g']
window-snap-two-third-left=['<Control><Alt>e']
window-snap-two-third-right=['<Control><Alt>t']
window-swap-down=['<Control><Super>j']
window-swap-last-active=['<Super>Return']
window-swap-left=['<Control><Super>h']
window-swap-right=['<Control><Super>l']
window-swap-up=['<Control><Super>k']
window-toggle-always-float=['<Shift><Super>c']
window-toggle-float=['<Super>c']
workspace-active-tile-toggle=['<Shift><Super>w']

[gnome-ui-tune]
increase-thumbnails-size='200%'

[gsconnect]
name='lean-pc'

[space-bar/appearance]
application-styles='.space-bar {\n  -natural-hpadding: 12px;\n}\n\n.space-bar-workspace-label.active {\n  margin: 0 4px;\n  background-color: rgba(255,255,255,0.3);\n  color: rgba(255,255,255,1);\n  border-color: rgba(0,0,0,0);\n  font-weight: 700;\n  border-radius: 4px;\n  border-width: 0px;\n  padding: 3px 8px;\n}\n\n.space-bar-workspace-label.inactive {\n  margin: 0 4px;\n  background-color: rgba(0,0,0,0);\n  color: rgba(255,255,255,1);\n  border-color: rgba(0,0,0,0);\n  font-weight: 700;\n  border-radius: 4px;\n  border-width: 0px;\n  padding: 3px 8px;\n}\n\n.space-bar-workspace-label.inactive.empty {\n  margin: 0 4px;\n  background-color: rgba(0,0,0,0);\n  color: rgba(255,255,255,0.5);\n  border-color: rgba(0,0,0,0);\n  font-weight: 700;\n  border-radius: 4px;\n  border-width: 0px;\n  padding: 3px 8px;\n}'

[space-bar/state]
version=33

[user-theme]
name=''

[workspace-indicator]
embed-previews=false
